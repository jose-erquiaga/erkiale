rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null &&
             (request.auth.token.email == 'jose.erquiaga@gmail.com' ||
              request.auth.token.email == 'milnelas77@gmail.com');
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'jose.erquiaga@gmail.com';
    }

    // --- VALIDATORS ---
    function isValidProject(data) {
      return data.keys().hasAll(['name', 'status', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.status in ['En curso', 'Pendiente', 'Finalizado'] &&
             data.ownerId is string && data.ownerId.size() > 0;
    }

    function isValidBudgetItem(data) {
      return data.keys().hasAll(['concept', 'qty', 'unit', 'price', 'total']) &&
             data.concept is string && data.concept.size() > 0 && data.concept.size() <= 300 &&
             data.qty is number && data.qty > 0 &&
             data.unit is string && data.unit.size() > 0 &&
             data.price is number && data.price >= 0 &&
             data.total is number && data.total >= 0;
    }

    function isValidExpenseItem(data) {
      return data.keys().hasAll(['concept', 'date', 'provider', 'tipo', 'total', 'paymentMethod']) &&
             data.concept is string && data.concept.size() > 0 && data.concept.size() <= 300 &&
             data.date is string &&
             data.provider is string &&
             data.tipo in ['material', 'trabajo'] &&
             data.total is number && data.total >= 0 &&
             data.paymentMethod in ['efectivo', 'tarjeta', 'transferencia', 'a_cuenta'];
    }

    function isValidGuild(data) {
      return data.keys().hasAll(['name', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.order is number;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['name', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.order is number;
    }

    function isValidSubcategory(data) {
      return data.keys().hasAll(['name', 'order']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.order is number;
    }

    function isValidHierarchicalCatalogItem(data) {
      return data.keys().hasAll(['description', 'unit', 'price']) &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 300 &&
             data.unit is string && data.unit.size() > 0 &&
             data.price is number && data.price >= 0;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['projectId', 'type', 'task', 'startDate']) &&
             data.projectId is string &&
             data.type in ['planning', 'meeting'] &&
             data.task is string && data.task.size() > 0 && data.task.size() <= 500 &&
             data.startDate is string;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- RULES ---

    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && isValidProject(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn();

      // Subcollections
      match /budget_items/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidBudgetItem(incoming());
        allow delete: if isSignedIn();
      }
      match /invoice_items/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidBudgetItem(incoming());
        allow delete: if isSignedIn();
      }
      match /expense_items/{itemId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidExpenseItem(incoming());
        allow delete: if isSignedIn();
      }
    }

    match /company_expenses/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidExpenseItem(incoming());
      allow delete: if isSignedIn();
    }

    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidCalendarEvent(incoming());
      allow delete: if isSignedIn();
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- CATALOG HIERARCHY (Gremio -> Estancia -> Tipo -> Subcategoria -> Item) ---
    // Read: any signed-in user (catalog + budgets need to browse it).
    // Create: any signed-in user (the catalog flow lets anyone quick-add a new
    //   Gremio/Estancia/Subcategoria while creating an item — an additive
    //   convenience, not a structural edit).
    // Rename/reorder/delete: admin only, via the Structure Manager panel.
    match /guilds/{guildId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidGuild(incoming());
      allow update: if isAdmin() && isValidGuild(incoming());
      allow delete: if isAdmin();

      match /rooms/{roomId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidRoom(incoming());
        allow update: if isAdmin() && isValidRoom(incoming());
        allow delete: if isAdmin();

        match /types/{typeId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();

          match /subcategories/{subcategoryId} {
            allow read: if isSignedIn();
            allow create: if isSignedIn() && isValidSubcategory(incoming());
            allow update: if isAdmin() && isValidSubcategory(incoming());
            allow delete: if isAdmin();

            match /items/{itemId} {
              allow read: if isSignedIn();
              allow create, update: if isSignedIn() && isValidHierarchicalCatalogItem(incoming());
              allow delete: if isSignedIn();
            }
          }
        }
      }
    }

    // Collection-group rules: required in addition to the nested rules above
    // because the app lists 'rooms'/'subcategories'/'items' across every guild
    // at once (collectionGroup queries) for a flat realtime view of the whole
    // hierarchy. Firestore only applies a nested `match` rule to queries scoped
    // to a known parent path; collection-group queries need the `{path=**}`
    // wildcard form to be granted access at all, so these are additive
    // (read-only) — they don't loosen the create/update/delete rules above.
    match /{path=**}/rooms/{roomId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/subcategories/{subcategoryId} {
      allow read: if isSignedIn();
    }
    match /{path=**}/items/{itemId} {
      allow read: if isSignedIn();
    }
  }
}
