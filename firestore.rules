rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null &&
             (request.auth.token.email == 'jose.erquiaga@gmail.com' ||
              request.auth.token.email == 'milnelas77@gmail.com');
    }

    // --- VALIDATORS ---
    function isValidProject(data) {
      return data.keys().hasAll(['name', 'status', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.status in ['En curso', 'Pendiente', 'Finalizado'] &&
             data.ownerId == request.auth.uid;
    }

    function isValidCatalogItem(data) {
      return data.keys().hasAll(['concept', 'unit', 'price']) &&
             data.concept is string && data.concept.size() > 0 && data.concept.size() <= 300 &&
             data.unit is string && data.unit.size() > 0 &&
             data.price is number &&
             (!data.keys().hasAny(['category']) || data.category is string) &&
             (!data.keys().hasAny(['id']) || data.id is number || data.id is string);
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['projectId', 'date', 'task']) &&
             (data.projectId is string || data.projectId is number) &&
             data.date is string &&
             data.task is string && data.task.size() > 0 && data.task.size() <= 500;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- RULES ---

    match /projects/{projectId} {
      allow get: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidProject(incoming()) &&
                      incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // Subcollections
      match /budget_items/{itemId} {
        allow read, write: if isSignedIn();
      }
      match /invoice_items/{itemId} {
        allow read, write: if isSignedIn();
      }
      match /expense_items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }

    match /catalog/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.method != 'create' && request.method != 'update' || isValidCatalogItem(incoming()));
    }

    match /calendar_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.method != 'create' && request.method != 'update' || isValidCalendarEvent(incoming()));
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
